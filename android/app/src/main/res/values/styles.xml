<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight, so the WebView reports the phone's light/dark setting to the page
         (prefers-color-scheme). Habit's Settings → Appearance → System depends on it; with
         the old Light-only theme the WebView always said "light". The page draws its own
         dark theme, and the WebView's automatic darkening stays off (the default for apps
         targeting Android 13+). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/habit_background</item>
    </style>

    <!-- Launch screen: the Habit mark on the app background. Android 12+ draws it with the
         system splash screen; older versions show the same layout from @drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/habit_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
