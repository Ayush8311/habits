    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "emoji-picker-react": "^4.22.3",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
