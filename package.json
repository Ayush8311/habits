{
  "name": "habits",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "android:sync": "npm run build && cap sync android",
